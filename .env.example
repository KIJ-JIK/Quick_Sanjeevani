# ========================================================
# Quick Sanjeevani - Root Environment Configuration Example
# ========================================================

# Application Runtime
NODE_ENV=development
PORT=5000
SERVER_PUBLIC_URL=http://localhost:5000

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/quick_sanjeevani
MONGODB_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Authentication & Security
JWT_SECRET=quick_sanjeevani_super_secret_jwt_key_2026_wHACKiest
JWT_EXPIRES_IN=7d
CIRCUIT_BREAKER_TIMEOUT=5000

# Twilio WhatsApp Service
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=+14155238886

# ElevenLabs Multilingual Voice Synthesis (Regional TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID_HINDI=your_elevenlabs_hindi_voice_id
ELEVENLABS_VOICE_ID_KANNADA=your_elevenlabs_kannada_voice_id

# Google Gemini NLP & Vision API (Two-Tier Intent & OCR)
GEMINI_API_KEY=your_gemini_api_key_here

# WhatsApp Bot Microservice Port
BOT_PORT=5001
